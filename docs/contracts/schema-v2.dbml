// Canonical relational contract: 32 application tables. IDs and FK columns use unsigned BIGINT in Laravel.
Table roles { id bigint [pk] name varchar(50) [not null] description varchar(255) created_at timestamp updated_at timestamp }
Table branches { id bigint [pk] name varchar(100) [not null] address varchar(255) phone varchar(20) manager_id bigint status varchar(20) [default: 'active'] created_at timestamp updated_at timestamp }
Table users { id bigint [pk] name varchar email varchar [unique] password varchar phone varchar(20) role_id bigint branch_id bigint status varchar(20) created_at timestamp updated_at timestamp }
Table units { id bigint [pk] name varchar(50) [not null] abbreviation varchar(10) created_at timestamp updated_at timestamp }
Table categories { id bigint [pk] name varchar(100) [not null] parent_category_id bigint description varchar(255) created_at timestamp updated_at timestamp }
Table brands { id bigint [pk] name varchar(100) [not null] description varchar(255) created_at timestamp updated_at timestamp }
Table products { id bigint [pk] name varchar(150) [not null] sku varchar(50) [unique] barcode varchar(50) [unique] category_id bigint brand_id bigint unit_id bigint unit_size decimal(10,3) shelf_life_days int cost_price decimal(10,2) selling_price decimal(10,2) min_stock_level int reorder_point int reorder_quantity int is_expiry_tracked boolean image_path varchar status varchar(20) created_at timestamp updated_at timestamp }
Table suppliers { id bigint [pk] name varchar(150) [not null] contact_person varchar(100) phone varchar(20) email varchar address varchar(255) rating decimal(3,2) status varchar(20) created_at timestamp updated_at timestamp }
Table product_suppliers { id bigint [pk] product_id bigint supplier_id bigint supply_price decimal(10,2) lead_time_days int min_order_qty int quality_score decimal(3,2) is_preferred boolean order_multiple int fulfillment_rate decimal(5,4) created_at timestamp updated_at timestamp }
Table inventory { id bigint [pk] product_id bigint branch_id bigint quantity_available int quantity_reserved int max_capacity int last_updated timestamp }
Table inventory_transactions { id bigint [pk] product_id bigint branch_id bigint transaction_type varchar(20) quantity int batch_id bigint quantity_before int quantity_after int reason varchar(100) reference_type varchar(50) reference_id bigint performed_by bigint notes varchar(255) created_at timestamp }
Table stock_transfers { id bigint [pk] product_id bigint from_branch_id bigint to_branch_id bigint quantity int status varchar(20) requested_by bigint approved_by bigint created_at timestamp updated_at timestamp }
Table purchase_orders { id bigint [pk] supplier_id bigint branch_id bigint order_date date expected_date date status varchar(20) total_amount decimal(12,2) created_by bigint is_auto_generated boolean created_at timestamp updated_at timestamp }
Table purchase_order_items { id bigint [pk] purchase_order_id bigint product_id bigint quantity int unit_price decimal(10,2) subtotal decimal(12,2) created_at timestamp updated_at timestamp }
Table purchases { id bigint [pk] purchase_order_id bigint product_id bigint batch_no varchar(50) expiry_date date quantity_received int unit_cost decimal(10,2) received_by bigint received_at timestamp created_at timestamp updated_at timestamp }
Table customers { id bigint [pk] name varchar(100) [not null] email varchar phone varchar(20) address varchar(255) loyalty_points int segment varchar(50) created_at timestamp updated_at timestamp }
Table sales { id bigint [pk] invoice_no varchar(50) [unique] branch_id bigint customer_id bigint cashier_id bigint sale_date timestamp subtotal decimal(12,2) discount_amount decimal(12,2) tax_amount decimal(12,2) total_amount decimal(12,2) payment_method varchar(30) status varchar(20) created_at timestamp updated_at timestamp }
Table sale_items { id bigint [pk] sale_id bigint product_id bigint quantity int unit_price decimal(10,2) discount decimal(10,2) subtotal decimal(12,2) created_at timestamp updated_at timestamp }
Table discounts { id bigint [pk] name varchar(100) type varchar(20) value decimal(10,2) product_id bigint category_id bigint batch_id bigint starts_at timestamp ends_at timestamp status varchar(20) created_at timestamp updated_at timestamp }
Table demand_forecasts { id bigint [pk] product_id bigint branch_id bigint forecast_date date predicted_demand decimal(10,2) model_used varchar(50) model_run_id bigint confidence_score decimal(4,2) generated_at timestamp }
Table stock_predictions { id bigint [pk] product_id bigint branch_id bigint predicted_stockout_date date current_stock decimal(10,2) predicted_demand decimal(10,2) recommended_reorder_qty int risk_level varchar(10) safety_stock decimal(10,2) reorder_point decimal(10,2) lead_time_days int generated_at timestamp }
Table sales_anomalies { id bigint [pk] product_id bigint branch_id bigint detected_date date expected_value decimal(10,2) actual_value decimal(10,2) deviation_score decimal(6,3) status varchar(20) notes varchar(255) created_at timestamp updated_at timestamp }
Table market_basket_rules { id bigint [pk] antecedent_product_id bigint consequent_product_id bigint support decimal(6,4) confidence decimal(6,4) lift decimal(6,4) generated_at timestamp }
Table product_promotions { id bigint [pk] product_id bigint customer_id bigint promotion_type varchar(30) message varchar(500) sent_at timestamp status varchar(20) opened boolean created_at timestamp updated_at timestamp }
Table ai_recommendations { id bigint [pk] type varchar(30) related_entity_type varchar(50) related_entity_id bigint recommendation_text varchar(500) priority varchar(10) priority_score decimal(6,2) factors json status varchar(20) generated_at timestamp reviewed_by bigint created_at timestamp updated_at timestamp }
Table audit_logs { id bigint [pk] user_id bigint action varchar(100) entity_type varchar(50) entity_id bigint details text ip_address varchar(45) created_at timestamp }
Table inventory_batches { id bigint [pk] product_id bigint branch_id bigint purchase_id bigint batch_no varchar(50) expiry_date date quantity_received int quantity_remaining int unit_cost decimal(10,2) received_at timestamp status varchar(20) created_at timestamp updated_at timestamp }
Table sale_item_batches { id bigint [pk] sale_item_id bigint inventory_batch_id bigint quantity int created_at timestamp }
Table system_settings { id bigint [pk] setting_group varchar(50) setting_key varchar(100) [unique] setting_value varchar(255) value_type varchar(20) description varchar(255) updated_by bigint updated_at timestamp }
Table cycle_counts { id bigint [pk] product_id bigint branch_id bigint batch_id bigint trigger_source varchar(30) baseline_mean decimal(10,2) baseline_std decimal(10,2) z_score decimal(6,3) system_quantity int physical_quantity int variance int status varchar(30) assigned_to bigint counted_by bigint reviewed_by bigint variance_reason varchar(255) previous_quantity int adjusted_quantity int adjustment_transaction_id bigint created_at timestamp updated_at timestamp closed_at timestamp }
Table markdown_recommendations { id bigint [pk] batch_id bigint product_id bigint branch_id bigint baseline_days int avg_daily_sales decimal(10,2) days_remaining int available_qty int projected_sales decimal(10,2) surplus_qty decimal(10,2) suggested_markdown_pct decimal(5,2) max_markdown_pct decimal(5,2) status varchar(20) approval_authority varchar(30) reviewed_by bigint reviewed_at timestamp discount_id bigint generated_at timestamp created_at timestamp updated_at timestamp }
Table model_runs { id bigint [pk] product_id bigint branch_id bigint model_used varchar(50) trained_at timestamp train_end_date date folds int mae decimal(10,3) rmse decimal(10,3) smape decimal(8,3) baseline_model varchar(50) baseline_smape decimal(8,3) beats_baseline boolean selected boolean params json }

Ref: users.role_id > roles.id
Ref: users.branch_id > branches.id
Ref: branches.manager_id > users.id
Ref: categories.parent_category_id > categories.id
Ref: products.category_id > categories.id
Ref: products.brand_id > brands.id
Ref: products.unit_id > units.id
Ref: product_suppliers.product_id > products.id
Ref: product_suppliers.supplier_id > suppliers.id
Ref: inventory.product_id > products.id
Ref: inventory.branch_id > branches.id
Ref: inventory_transactions.batch_id > inventory_batches.id
Ref: purchases.purchase_order_id > purchase_orders.id
Ref: inventory_batches.purchase_id > purchases.id
Ref: sales.customer_id > customers.id
Ref: sale_items.sale_id > sales.id
Ref: sale_item_batches.sale_item_id > sale_items.id
Ref: sale_item_batches.inventory_batch_id > inventory_batches.id
Ref: discounts.batch_id > inventory_batches.id
Ref: demand_forecasts.model_run_id > model_runs.id
Ref: cycle_counts.adjustment_transaction_id > inventory_transactions.id
Ref: markdown_recommendations.discount_id > discounts.id
